# Copie para .env (o instalar.sh faz isso) e preencha. O .env NUNCA vai para o Git.

# Endereço do sistema; o domínio precisa apontar para o IP do servidor (registro A).
DOMINIO=genossensor.exemplo.com.br

# Chave das sessões de login (o instalar.sh gera uma aleatória).
FIEP_SECRET=

# Primeiro administrador: criado só se o banco não tiver nenhum usuário.
# Depois do primeiro acesso, troque a senha pela tela e apague a linha da senha daqui.
FIEP_ADMIN_EMAIL=
FIEP_ADMIN_SENHA=

# Backup: destino do rclone para a cópia fora do servidor (ex.: drive:backup-fiep). Vazio = só local.
RCLONE_DESTINO=
# Quantos backups manter na pasta local backups/.
BACKUPS_MANTER=14
